# Copy to apps/api/.env and adjust. Without a .env the API runs on an embedded
# development database (PGlite) with a throw-away session secret.

PORT=3201

# --- Database -----------------------------------------------------------------
# postgres = a real PostgreSQL server (Supabase); pglite = embedded, development only
DB_DRIVER=postgres
# Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
# Apply pending migrations at start-up. Defaults to false for postgres (run
# "pnpm db:migrate" deliberately) and true for pglite.
# DB_AUTO_MIGRATE=false

# --- Sessions -----------------------------------------------------------------
# Required in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_HOURS=8
# Set true when the site is served over HTTPS (the default in production)
# COOKIE_SECURE=true

# --- Statement extraction -----------------------------------------------------
# Embedding model for target names on UOB statements. Downloaded once from
# huggingface.co (about 90 MB) into NER_ML_CACHE_DIR on first use; set false to
# use pattern-based extraction only.
NER_ML_ENABLED=true
NER_ML_CACHE_DIR=.model-cache
UPLOAD_MAX_MB=25
